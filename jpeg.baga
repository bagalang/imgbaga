// jpeg.baga — baseline DCT JPEG decode (SOF0), image-rs jpeg subset.
// Integer IDCT after nanojpeg (Loeffler / Arai / Nakajima). Encode: jpeg_enc.baga.

import "types.baga"
import "jpeg_core.baga"
import "jpeg_idct.baga"

fn jpg_next_byte(j: Jpg) -> Jpg {
    if j.pos >= bytes_len(j.data) {
        return jpg_fail(j, "jpeg: truncated stream")
    }
    let b = bytes_at(j.data, j.pos) & 255
    j.pos = j.pos + 1
    if b != 255 {
        j.bitbuf = b
        return j
    }
    let mut running = 1
    while running == 1 {
        if j.pos >= bytes_len(j.data) {
            return jpg_fail(j, "jpeg: truncated after FF")
        }
        let m = bytes_at(j.data, j.pos) & 255
        j.pos = j.pos + 1
        if m == 255 {
            running = 1
        } else {
            if m == 0 {
                j.bitbuf = 255
                return j
            }
            if m >= 208 && m <= 215 {
                j.bitbuf = 0
                j.nbits = 0
                vec_set(j.dcpred, 0, 0)
                vec_set(j.dcpred, 1, 0)
                vec_set(j.dcpred, 2, 0)
                vec_set(j.dcpred, 3, 0)
                return jpg_next_byte(j)
            }
            return jpg_fail(j, "jpeg: unexpected marker in scan")
        }
    }
    return j
}

fn jpg_getbit(j: Jpg) -> Jpg {
    if j.ok == 0 {
        return j
    }
    if j.nbits == 0 {
        let j2 = jpg_next_byte(j)
        if j2.ok == 0 {
            return j2
        }
        j2.nbits = 8
        return jpg_take_bit(j2)
    }
    return jpg_take_bit(j)
}

fn jpg_take_bit(j: Jpg) -> Jpg {
    j.nbits = j.nbits - 1
    let v = (j.bitbuf >> j.nbits) & 1
    j.ok = v + 2
    return j
}

fn jpg_bit(j: Jpg) -> i64 {
    return j.ok - 2
}

fn jpg_receive(j0: Jpg, t: i64) -> Jpg {
    let mut j = j0
    let mut v: i64 = 0
    let mut k: i64 = 0
    while k < t {
        j = jpg_getbit(j)
        if j.ok < 2 {
            return j
        }
        v = (v << 1) | jpg_bit(j)
        k = k + 1
    }
    return jpg_stash(j, v)
}

fn jpg_stash(j: Jpg, v: i64) -> Jpg {
    j.stash = v
    j.ok = 1
    return j
}

fn jpg_stashed(j: Jpg) -> i64 {
    return j.stash
}

fn jpg_extend(v: i64, t: i64) -> i64 {
    if t == 0 {
        return 0
    }
    let vt = 1 << (t - 1)
    if v < vt {
        return v - (1 << t) + 1
    }
    return v
}

fn jpg_huff_dec(j0: Jpg, h: JpgHuff) -> Jpg {
    if h.ok == 0 {
        return jpg_fail(j0, "jpeg: empty huffman table")
    }
    let mut j = jpg_getbit(j0)
    if j.ok < 2 {
        return j
    }
    let mut code = jpg_bit(j)
    let mut l: i64 = 1
    while l <= 16 {
        if vec_get(h.maxcode, l) >= 0 && code <= vec_get(h.maxcode, l) {
            let idx = vec_get(h.valptr, l) + code - vec_get(h.mincode, l)
            if idx < 0 || idx >= vec_len(h.vals) {
                return jpg_fail(j, "jpeg: huff index")
            }
            return jpg_stash(j, vec_get(h.vals, idx))
        }
        j = jpg_getbit(j)
        if j.ok < 2 {
            return j
        }
        code = (code << 1) | jpg_bit(j)
        l = l + 1
    }
    return jpg_fail(j, "jpeg: bad huffman code")
}
fn jpg_decode_block(j0: Jpg, ci: i64) -> Jpg {
    let zz = jpg_zz()
    let td = vec_get(j0.ctd, ci)
    let ta = vec_get(j0.cta, ci)
    let tq = vec_get(j0.ctq, ci)
    let hdc = jpg_get_hdc(j0, td)
    let mut j = jpg_huff_dec(j0, hdc)
    if j.ok == 0 {
        return j
    }
    let s = jpg_stashed(j)
    let mut diff: i64 = 0
    if s != 0 {
        j = jpg_receive(j, s)
        if j.ok == 0 {
            return j
        }
        diff = jpg_extend(jpg_stashed(j), s)
    }
    let dc = vec_get(j.dcpred, ci) + diff
    vec_set(j.dcpred, ci, dc)
    let blk = vec_zeros(64)
    let q0 = tq * 64
    vec_set(blk, 0, dc * vec_get(j.qt, q0))
    let hac = jpg_get_hac(j, ta)
    let mut k: i64 = 1
    while k < 64 {
        j = jpg_huff_dec(j, hac)
        if j.ok == 0 {
            return j
        }
        let rs = jpg_stashed(j)
        let rr = rs >> 4
        let sz = rs & 15
        if sz == 0 {
            if rr != 15 {
                k = 64
            } else {
                k = k + 16
            }
        } else {
            k = k + rr
            if k >= 64 {
                return jpg_fail(j, "jpeg: ac overflow")
            }
            j = jpg_receive(j, sz)
            if j.ok == 0 {
                return j
            }
            let ac = jpg_extend(jpg_stashed(j), sz)
            let nat = vec_get(zz, k)
            vec_set(blk, nat, ac * vec_get(j.qt, q0 + nat))
            k = k + 1
        }
    }
    jpg_idct(blk)
    let mut i: i64 = 0
    while i < 64 {
        vec_set(j.outblk, i, vec_get(blk, i))
        i = i + 1
    }
    j.ok = 1
    return j
}

fn jpg_copy_block(dst: Vec<i64>, blk_off: i64, j: Jpg) {
    let mut i: i64 = 0
    while i < 64 {
        vec_set(dst, blk_off + i, vec_get(j.outblk, i))
        i = i + 1
    }
}

fn jpg_find_comp(j: Jpg, id: i64) -> i64 {
    let mut i: i64 = 0
    while i < j.ncomp {
        if vec_get(j.cid, i) == id {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn jpg_parse_dqt(j: Jpg, start: i64, end: i64) -> Jpg {
    let mut p = start
    while p < end {
        if p >= bytes_len(j.data) {
            return jpg_fail(j, "jpeg: DQT truncated")
        }
        let pqtq = bytes_at(j.data, p) & 255
        p = p + 1
        let pq = pqtq >> 4
        let tq = pqtq & 15
        if tq > 3 {
            return jpg_fail(j, "jpeg: bad qt id")
        }
        let zz = jpg_zz()
        let mut k: i64 = 0
        while k < 64 {
            let mut v: i64 = 0
            if pq == 0 {
                if p >= end {
                    return jpg_fail(j, "jpeg: DQT short")
                }
                v = bytes_at(j.data, p) & 255
                p = p + 1
            } else {
                if p + 1 >= end {
                    return jpg_fail(j, "jpeg: DQT short16")
                }
                v = img_be16(j.data, p)
                p = p + 2
            }
            vec_set(j.qt, tq * 64 + vec_get(zz, k), v)
            k = k + 1
        }
    }
    return j
}

fn jpg_parse_dht(j0: Jpg, start: i64, end: i64) -> Jpg {
    let mut j = j0
    let mut p = start
    while p < end {
        if p >= bytes_len(j.data) {
            return jpg_fail(j, "jpeg: DHT truncated")
        }
        let tcth = bytes_at(j.data, p) & 255
        p = p + 1
        let tc = tcth >> 4
        let th = tcth & 15
        if th > 3 || tc > 1 {
            return jpg_fail(j, "jpeg: bad DHT id")
        }
        if p + 16 > end {
            return jpg_fail(j, "jpeg: DHT bits")
        }
        let bits = vec_zeros(17)
        let mut nsym: i64 = 0
        let mut i: i64 = 1
        while i <= 16 {
            let nb = bytes_at(j.data, p) & 255
            vec_set(bits, i, nb)
            nsym = nsym + nb
            p = p + 1
            i = i + 1
        }
        if p + nsym > end {
            return jpg_fail(j, "jpeg: DHT vals")
        }
        let vals = vec_new()
        let mut k: i64 = 0
        while k < nsym {
            vec_push(vals, bytes_at(j.data, p) & 255)
            p = p + 1
            k = k + 1
        }
        let h = huff_build(bits, vals)
        if tc == 0 {
            j = jpg_set_hdc(j, th, h)
        } else {
            j = jpg_set_hac(j, th, h)
        }
    }
    return j
}

fn jpg_ycbcr(y: i64, cb: i64, cr: i64) -> Pixel {
    let cbb = cb - 128
    let crr = cr - 128
    let r = img_clamp8(y + (359 * crr + 128) / 256)
    let g = img_clamp8(y - (88 * cbb + 183 * crr + 128) / 256)
    let b = img_clamp8(y + (454 * cbb + 128) / 256)
    return Pixel { r: r, g: g, b: b, a: 255 }
}

fn jpeg_decode(src: bytes) -> Image {
    if bytes_len(src) < 4 {
        return img_fail("jpeg: truncated")
    }
    if (bytes_at(src, 0) & 255) != 255 || (bytes_at(src, 1) & 255) != 216 {
        return img_fail("jpeg: no SOI")
    }
    let mut j = jpg_new(src)
    j.pos = 2
    let n = bytes_len(src)
    let mut seen_sos: i64 = 0
    while j.ok == 1 && seen_sos == 0 && j.pos + 2 <= n {
        if (bytes_at(j.data, j.pos) & 255) != 255 {
            return img_fail("jpeg: lost marker sync")
        }
        let mut mk = bytes_at(j.data, j.pos + 1) & 255
        j.pos = j.pos + 2
        while mk == 255 && j.pos < n {
            mk = bytes_at(j.data, j.pos) & 255
            j.pos = j.pos + 1
        }
        if mk == 216 {
            // extra SOI
        } else {
            if mk == 217 {
                return img_fail("jpeg: EOI before SOS")
            }
            if mk == 1 || (mk >= 208 && mk <= 215) {
                // TEM / RST standalone
            } else {
                if j.pos + 2 > n {
                    return img_fail("jpeg: truncated marker")
                }
                let len = img_be16(j.data, j.pos)
                if len < 2 {
                    return img_fail("jpeg: bad marker len")
                }
                let start = j.pos + 2
                let end = j.pos + len
                if end > n {
                    return img_fail("jpeg: marker past end")
                }
                j.pos = end
                if mk == 192 {
                    j = jpg_parse_sof(j, start, end)
                } else {
                    if mk == 193 || mk == 194 || mk == 195 {
                        return img_fail("jpeg: only baseline SOF0")
                    }
                    if mk == 196 {
                        j = jpg_parse_dht(j, start, end)
                    } else {
                        if mk == 219 {
                            j = jpg_parse_dqt(j, start, end)
                        } else {
                            if mk == 221 {
                                if end - start >= 2 {
                                    j.ri = img_be16(j.data, start)
                                }
                            } else {
                                if mk == 218 {
                                    j = jpg_parse_sos(j, start, end)
                                    seen_sos = 1
                                    j.pos = end
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if j.ok == 0 {
        return img_fail(j.err)
    }
    if seen_sos == 0 {
        return img_fail("jpeg: no SOS")
    }
    return jpg_scan(j)
}

fn jpg_parse_sof(j: Jpg, start: i64, end: i64) -> Jpg {
    if end - start < 6 {
        return jpg_fail(j, "jpeg: short SOF")
    }
    let prec = bytes_at(j.data, start) & 255
    if prec != 8 {
        return jpg_fail(j, "jpeg: only 8-bit")
    }
    j.h = img_be16(j.data, start + 1)
    j.w = img_be16(j.data, start + 3)
    j.ncomp = bytes_at(j.data, start + 5) & 255
    if j.w <= 0 || j.h <= 0 || j.w > 4096 || j.h > 4096 {
        return jpg_fail(j, "jpeg: bad size")
    }
    if j.ncomp != 1 && j.ncomp != 3 {
        return jpg_fail(j, "jpeg: only 1 or 3 components")
    }
    if start + 6 + j.ncomp * 3 > end {
        return jpg_fail(j, "jpeg: SOF comps")
    }
    let mut i: i64 = 0
    while i < j.ncomp {
        let o = start + 6 + i * 3
        vec_set(j.cid, i, bytes_at(j.data, o) & 255)
        let hv = bytes_at(j.data, o + 1) & 255
        vec_set(j.ch, i, hv >> 4)
        vec_set(j.cv, i, hv & 15)
        vec_set(j.ctq, i, bytes_at(j.data, o + 2) & 255)
        i = i + 1
    }
    return j
}

fn jpg_parse_sos(j: Jpg, start: i64, end: i64) -> Jpg {
    if end - start < 1 {
        return jpg_fail(j, "jpeg: short SOS")
    }
    let ns = bytes_at(j.data, start) & 255
    if start + 1 + ns * 2 + 3 > end {
        return jpg_fail(j, "jpeg: SOS comps")
    }
    let mut i: i64 = 0
    while i < ns {
        let id = bytes_at(j.data, start + 1 + i * 2) & 255
        let tdta = bytes_at(j.data, start + 2 + i * 2) & 255
        let ci = jpg_find_comp(j, id)
        if ci < 0 {
            return jpg_fail(j, "jpeg: SOS unknown id")
        }
        vec_set(j.ctd, ci, tdta >> 4)
        vec_set(j.cta, ci, tdta & 15)
        i = i + 1
    }
    return j
}

fn jpg_scan(j0: Jpg) -> Image {
    let mut j = j0
    j.nbits = 0
    vec_set(j.dcpred, 0, 0)
    vec_set(j.dcpred, 1, 0)
    vec_set(j.dcpred, 2, 0)
    vec_set(j.dcpred, 3, 0)
    let mut hmax: i64 = 1
    let mut vmax: i64 = 1
    let mut i: i64 = 0
    while i < j.ncomp {
        if vec_get(j.ch, i) > hmax { hmax = vec_get(j.ch, i) }
        if vec_get(j.cv, i) > vmax { vmax = vec_get(j.cv, i) }
        i = i + 1
    }
    let mcu_w = 8 * hmax
    let mcu_h = 8 * vmax
    let nx = (j.w + mcu_w - 1) / mcu_w
    let ny = (j.h + mcu_h - 1) / mcu_h
    let px = bytes_new(j.w * j.h * 4)
    // max blocks per MCU: 4+1+1 typical; allow 10 * 64
    let plane = vec_zeros(10 * 64)
    let mut my: i64 = 0
    let mut mcu_i: i64 = 0
    while my < ny {
        let mut mx: i64 = 0
        while mx < nx {
            if j.ri > 0 && mcu_i > 0 && (mcu_i % j.ri) == 0 {
                j.nbits = 0
                vec_set(j.dcpred, 0, 0)
                vec_set(j.dcpred, 1, 0)
                vec_set(j.dcpred, 2, 0)
                vec_set(j.dcpred, 3, 0)
            }
            let mut boff: i64 = 0
            let starts = vec_zeros(4)
            let mut c: i64 = 0
            while c < j.ncomp {
                vec_set(starts, c, boff)
                let hb = vec_get(j.ch, c)
                let vb = vec_get(j.cv, c)
                let mut by: i64 = 0
                while by < vb {
                    let mut bx: i64 = 0
                    while bx < hb {
                        j = jpg_decode_block(j, c)
                        if j.ok == 0 {
                            return img_fail(j.err)
                        }
                        jpg_copy_block(plane, boff, j)
                        boff = boff + 64
                        bx = bx + 1
                    }
                    by = by + 1
                }
                c = c + 1
            }
            let mut yy: i64 = 0
            while yy < mcu_h {
                let py = my * mcu_h + yy
                if py < j.h {
                    let mut xx: i64 = 0
                    while xx < mcu_w {
                        let px_ = mx * mcu_w + xx
                        if px_ < j.w {
                            let yv = jpg_sample(plane, vec_get(starts, 0), vec_get(j.ch, 0), vec_get(j.cv, 0), hmax, vmax, xx, yy)
                            let mut cb = 128
                            let mut cr = 128
                            if j.ncomp == 3 {
                                cb = jpg_sample(plane, vec_get(starts, 1), vec_get(j.ch, 1), vec_get(j.cv, 1), hmax, vmax, xx, yy)
                                cr = jpg_sample(plane, vec_get(starts, 2), vec_get(j.ch, 2), vec_get(j.cv, 2), hmax, vmax, xx, yy)
                            }
                            let p = jpg_ycbcr(yv, cb, cr)
                            if j.ncomp == 1 {
                                let o = (py * j.w + px_) * 4
                                bytes_set(px, o, yv)
                                bytes_set(px, o + 1, yv)
                                bytes_set(px, o + 2, yv)
                                bytes_set(px, o + 3, 255)
                            } else {
                                let o = (py * j.w + px_) * 4
                                bytes_set(px, o, p.r)
                                bytes_set(px, o + 1, p.g)
                                bytes_set(px, o + 2, p.b)
                                bytes_set(px, o + 3, 255)
                            }
                        }
                        xx = xx + 1
                    }
                }
                yy = yy + 1
            }
            mcu_i = mcu_i + 1
            mx = mx + 1
        }
        my = my + 1
    }
    return img_ok(j.w, j.h, px)
}

fn jpg_sample(plane: Vec<i64>, start: i64, hs: i64, vs: i64, hmax: i64, vmax: i64, x: i64, y: i64) -> i64 {
    let sx = x * hs / hmax
    let sy = y * vs / vmax
    let bx = sx / 8
    let by = sy / 8
    let ix = sx % 8
    let iy = sy % 8
    let bi = by * hs + bx
    return vec_get(plane, start + bi * 64 + iy * 8 + ix)
}
