fn je_std_chr() -> Vec<i64> {
    let t = vec_new()
    let mut i: i64 = 0
    while i < 64 {
        let mut v = 99
        if i == 0 { v = 17 }
        if i == 1 { v = 18 }
        if i == 2 { v = 24 }
        if i == 3 { v = 47 }
        if i == 8 { v = 18 }
        if i == 9 { v = 21 }
        if i == 10 { v = 26 }
        if i == 11 { v = 66 }
        if i == 16 { v = 24 }
        if i == 17 { v = 26 }
        if i == 18 { v = 56 }
        if i == 24 { v = 47 }
        if i == 25 { v = 66 }
        vec_push(t, v)
        i = i + 1
    }
    return t
}
fn je_bytes_to_vec(b: bytes) -> Vec<i64> {
    let v = vec_new()
    let mut i: i64 = 0
    while i < bytes_len(b) {
        vec_push(v, bytes_at(b, i) & 255)
        i = i + 1
    }
    return v
}

fn je_bits_dc_lum() -> Vec<i64> {
    let b = je_zeros(17)
    vec_set(b, 2, 1)
    vec_set(b, 3, 5)
    vec_set(b, 4, 1)
    vec_set(b, 5, 1)
    vec_set(b, 6, 1)
    vec_set(b, 7, 1)
    vec_set(b, 8, 1)
    vec_set(b, 9, 1)
    return b
}

fn je_bits_dc_chr() -> Vec<i64> {
    let b = je_zeros(17)
    vec_set(b, 2, 3)
    vec_set(b, 3, 1)
    vec_set(b, 4, 1)
    vec_set(b, 5, 1)
    vec_set(b, 6, 1)
    vec_set(b, 7, 1)
    vec_set(b, 8, 1)
    vec_set(b, 9, 1)
    vec_set(b, 10, 1)
    vec_set(b, 11, 1)
    return b
}

fn je_bits_ac_lum() -> Vec<i64> {
    let b = je_zeros(17)
    vec_set(b, 2, 2)
    vec_set(b, 3, 1)
    vec_set(b, 4, 3)
    vec_set(b, 5, 3)
    vec_set(b, 6, 2)
    vec_set(b, 7, 4)
    vec_set(b, 8, 3)
    vec_set(b, 9, 5)
    vec_set(b, 10, 5)
    vec_set(b, 11, 4)
    vec_set(b, 12, 4)
    vec_set(b, 15, 1)
    vec_set(b, 16, 125)
    return b
}

fn je_bits_ac_chr() -> Vec<i64> {
    let b = je_zeros(17)
    vec_set(b, 2, 2)
    vec_set(b, 3, 1)
    vec_set(b, 4, 2)
    vec_set(b, 5, 4)
    vec_set(b, 6, 4)
    vec_set(b, 7, 3)
    vec_set(b, 8, 4)
    vec_set(b, 9, 7)
    vec_set(b, 10, 5)
    vec_set(b, 11, 4)
    vec_set(b, 12, 4)
    vec_set(b, 14, 1)
    vec_set(b, 15, 2)
    vec_set(b, 16, 119)
    return b
}

fn je_vals_dc() -> Vec<i64> {
    let v = vec_new()
    let mut i: i64 = 0
    while i < 12 {
        vec_push(v, i)
        i = i + 1
    }
    return v
}

fn je_vals_ac_lum() -> Vec<i64> {
    return je_bytes_to_vec(hex_decode(""))
}

fn je_vals_ac_chr() -> Vec<i64> {
    return je_bytes_to_vec(hex_decode(""))
}
