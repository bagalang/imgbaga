// jpeg_enc_tab.baga — Annex K Huffman + quant + zigzag + FDCT cosines.

import "types.baga"

fn je_zeros(n: i64) -> Vec<i64> {
    let v = vec_new()
    let mut i: i64 = 0
    while i < n {
        vec_push(v, 0)
        i = i + 1
    }
    return v
}

