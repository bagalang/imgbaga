// img.baga — public surface for imgbaga (image-rs: open / load / save / guess).
//
//   img_guess / img_info / img_load / img_load_format
//   img_open / img_save / img_encode
//   img_new / img_pixel / img_put
//   img_crop / img_flip_h / img_flip_v / img_rotate90 / img_resize
//   img_grayscale / img_invert
//
// Decode: PNG JPEG GIF BMP PNM QOI ICO TIFF WebP (VP8 + VP8L).
// Encode: PNG JPEG BMP PNM QOI ICO.

import "types.baga"
import "sniff.baga"
import "ops.baga"
import "bmp.baga"
import "pnm.baga"
import "png.baga"
import "jpeg.baga"
import "jpeg_enc.baga"
import "gif.baga"
import "qoi.baga"
import "ico.baga"
import "tiff.baga"
import "webp.baga"
import "pathbaga/path.baga"
import "std/os/os.baga"

fn img_info(b: bytes) -> ImgInfo {
    let f = img_guess(b)
    if f == img_fmt_png() {
        return png_info(b)
    }
    if f == img_fmt_jpeg() {
        return jpeg_info(b)
    }
    if f == img_fmt_bmp() {
        return bmp_info(b)
    }
    if f == img_fmt_pnm() {
        return pnm_info(b)
    }
    if f == img_fmt_gif() {
        return gif_info(b)
    }
    if f == img_fmt_qoi() {
        return qoi_info(b)
    }
    if f == img_fmt_ico() {
        return ico_info(b)
    }
    if f == img_fmt_tiff() {
        return tiff_info(b)
    }
    if f == img_fmt_webp() {
        return webp_info(b)
    }
    if f == img_fmt_unknown() {
        return img_info_fail("img: unknown format")
    }
    return ImgInfo { format: f, w: 0, h: 0, ok: 1, err: "" }
}

// I4 (closed 2026-10-31): bounded load — probe хедъра primeiro (без пълен
// decode), отхвърля ако над max_w/max_h, иначе decode + downscale до лимита.
// Peak memory остава пълното decode, но големи входове се спират рано.
fn img_load_bounded(b: bytes, max_w: i64, max_h: i64) -> Image {
    let info = img_info(b)
    if info.ok == 0 {
        return img_fail(info.err)
    }
    if max_w > 0 && info.w > max_w {
        return img_fail(concat("img: width ", concat(int_to_str(info.w), concat(" over limit ", int_to_str(max_w)))))
    }
    if max_h > 0 && info.h > max_h {
        return img_fail(concat("img: height ", concat(int_to_str(info.h), concat(" over limit ", int_to_str(max_h)))))
    }
    let im = img_load(b)
    if im.ok == 0 {
        return im
    }
    // downscale ако е над лимита (все пак е заредено, но връщаме thumbnail)
    if max_w > 0 && im.w > max_w {
        let mut nh = im.h * max_w / im.w
        if nh < 1 { nh = 1 }
        return img_resize_nearest(im, max_w, nh)
    }
    if max_h > 0 && im.h > max_h {
        let mut nw = im.w * max_h / im.h
        if nw < 1 { nw = 1 }
        return img_resize_nearest(im, nw, max_h)
    }
    return im
}

fn img_load_format(b: bytes, fmt: i64) -> Image {
    if fmt == img_fmt_png() {
        return png_decode(b)
    }
    if fmt == img_fmt_jpeg() {
        return jpeg_decode(b)
    }
    if fmt == img_fmt_bmp() {
        return bmp_decode(b)
    }
    if fmt == img_fmt_pnm() {
        return pnm_decode(b)
    }
    if fmt == img_fmt_gif() {
        return gif_decode(b)
    }
    if fmt == img_fmt_qoi() {
        return qoi_decode(b)
    }
    if fmt == img_fmt_ico() {
        return ico_decode(b)
    }
    if fmt == img_fmt_tiff() {
        return tiff_decode(b)
    }
    if fmt == img_fmt_webp() {
        return webp_decode(b)
    }
    return img_fail(concat("img: decode not in v1: ", img_fmt_name(fmt)))
}

fn img_load(b: bytes) -> Image {
    let f = img_guess(b)
    if f == img_fmt_unknown() {
        return img_fail("img: unknown format")
    }
    return img_load_format(b, f)
}

fn img_encode(im: Image, fmt: i64) -> bytes {
    if im.ok == 0 {
        return bytes_new(0)
    }
    if fmt == img_fmt_png() {
        return png_encode(im)
    }
    if fmt == img_fmt_bmp() {
        return bmp_encode(im)
    }
    if fmt == img_fmt_pnm() {
        return pnm_encode(im)
    }
    if fmt == img_fmt_jpeg() {
        return jpeg_encode(im)
    }
    if fmt == img_fmt_qoi() {
        return qoi_encode(im)
    }
    if fmt == img_fmt_ico() {
        return ico_encode(im)
    }
    return bytes_new(0)
}

fn img_open(path: str) -> Image !IO {
    let b = read_file_bytes(path)?
    return img_load(b)
}

fn img_save(im: Image, path: str) -> i64 !IO {
    let fmt = img_fmt_from_ext(path_ext(path))
    if fmt == img_fmt_unknown() {
        return 0
    }
    let out = img_encode(im, fmt)
    if bytes_len(out) == 0 {
        return 0
    }
    let rc = write_file_bytes(path, out)?
    if rc < 0 {
        return 0
    }
    return 1
}
