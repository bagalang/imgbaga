// jpeg_core.baga — JPEG Huffman tables, Jpg state, SOF info.

import "types.baga"

fn jpg_zz() -> Vec<i64> {
    let z = vec_new()
    vec_push(z, 0)
    vec_push(z, 1)
    vec_push(z, 8)
    vec_push(z, 16)
    vec_push(z, 9)
    vec_push(z, 2)
    vec_push(z, 3)
    vec_push(z, 10)
    vec_push(z, 17)
    vec_push(z, 24)
    vec_push(z, 32)
    vec_push(z, 25)
    vec_push(z, 18)
    vec_push(z, 11)
    vec_push(z, 4)
    vec_push(z, 5)
    vec_push(z, 12)
    vec_push(z, 19)
    vec_push(z, 26)
    vec_push(z, 33)
    vec_push(z, 40)
    vec_push(z, 48)
    vec_push(z, 41)
    vec_push(z, 34)
    vec_push(z, 27)
    vec_push(z, 20)
    vec_push(z, 13)
    vec_push(z, 6)
    vec_push(z, 7)
    vec_push(z, 14)
    vec_push(z, 21)
    vec_push(z, 28)
    vec_push(z, 35)
