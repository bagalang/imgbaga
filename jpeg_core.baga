    return z
}

fn vec_zeros(n: i64) -> Vec<i64> {
    let v = vec_new()
    let mut i: i64 = 0
    while i < n {
        vec_push(v, 0)
        i = i + 1
    }
    return v
}

struct JpgHuff {
    mincode: Vec<i64>,
    maxcode: Vec<i64>,
    valptr: Vec<i64>,
    vals: Vec<i64>,
    ok: i64
}

fn huff_empty() -> JpgHuff {
    return JpgHuff {
        mincode: vec_zeros(17),
        maxcode: vec_zeros(17),
        valptr: vec_zeros(17),
        vals: vec_new(),
        ok: 0
    }
}

fn huff_build(bits: Vec<i64>, vals: Vec<i64>) -> JpgHuff {
    let minc = vec_zeros(17)
    let maxc = vec_zeros(17)
    let vp = vec_zeros(17)
    let mut code: i64 = 0
    let mut p: i64 = 0
    let mut l: i64 = 1
    while l <= 16 {
        let nb = vec_get(bits, l)
        if nb != 0 {
            vec_set(vp, l, p)
            vec_set(minc, l, code)
            p = p + nb
            code = code + nb
            vec_set(maxc, l, code - 1)
        } else {
            vec_set(maxc, l, 0 - 1)
        }
        code = code * 2
        l = l + 1
    }
    return JpgHuff { mincode: minc, maxcode: maxc, valptr: vp, vals: vals, ok: 1 }
}

struct Jpg {
    data: bytes,
    pos: i64,
    bitbuf: i64,
    nbits: i64,
    ok: i64,
    err: str,
    w: i64,
    h: i64,
    ncomp: i64,
    cid: Vec<i64>,
    ch: Vec<i64>,
    cv: Vec<i64>,
    ctq: Vec<i64>,
    ctd: Vec<i64>,
    cta: Vec<i64>,
    dcpred: Vec<i64>,
    qt: Vec<i64>,
    hdc0: JpgHuff,
    hdc1: JpgHuff,
    hdc2: JpgHuff,
    hdc3: JpgHuff,
    hac0: JpgHuff,
    hac1: JpgHuff,
    hac2: JpgHuff,
    hac3: JpgHuff,
    ri: i64,
    stash: i64,
    outblk: Vec<i64>
}

fn jpg_new(data: bytes) -> Jpg {
    return Jpg {
        data: data, pos: 0, bitbuf: 0, nbits: 0, ok: 1, err: "",
        w: 0, h: 0, ncomp: 0,
        cid: vec_zeros(4), ch: vec_zeros(4), cv: vec_zeros(4),
        ctq: vec_zeros(4), ctd: vec_zeros(4), cta: vec_zeros(4),
        dcpred: vec_zeros(4), qt: vec_zeros(256),
        hdc0: huff_empty(), hdc1: huff_empty(), hdc2: huff_empty(), hdc3: huff_empty(),
        hac0: huff_empty(), hac1: huff_empty(), hac2: huff_empty(), hac3: huff_empty(),
        ri: 0, stash: 0, outblk: vec_zeros(64)
    }
}

fn jpg_fail(j: Jpg, msg: str) -> Jpg {
    j.ok = 0
    j.err = msg
    return j
}

fn jpg_get_hdc(j: Jpg, i: i64) -> JpgHuff {
    if i == 1 { return j.hdc1 }
    if i == 2 { return j.hdc2 }
    if i == 3 { return j.hdc3 }
    return j.hdc0
}

fn jpg_get_hac(j: Jpg, i: i64) -> JpgHuff {
    if i == 1 { return j.hac1 }
    if i == 2 { return j.hac2 }
    if i == 3 { return j.hac3 }
    return j.hac0
}

fn jpg_set_hdc(j: Jpg, i: i64, h: JpgHuff) -> Jpg {
    if i == 1 { j.hdc1 = h }
    if i == 2 { j.hdc2 = h }
    if i == 3 { j.hdc3 = h }
    if i == 0 { j.hdc0 = h }
    return j
}

fn jpg_set_hac(j: Jpg, i: i64, h: JpgHuff) -> Jpg {
    if i == 1 { j.hac1 = h }
    if i == 2 { j.hac2 = h }
    if i == 3 { j.hac3 = h }
    if i == 0 { j.hac0 = h }
    return j
}

fn jpeg_info(b: bytes) -> ImgInfo {
    if bytes_len(b) < 4 {
        return img_info_fail("jpeg: truncated")
    }
    if (bytes_at(b, 0) & 255) != 255 || (bytes_at(b, 1) & 255) != 216 {
        return img_info_fail("jpeg: no SOI")
    }
    let n = bytes_len(b)
    let mut i: i64 = 2
    while i + 4 <= n {
        if (bytes_at(b, i) & 255) != 255 {
            i = i + 1
        } else {
            let mut mk = bytes_at(b, i + 1) & 255
            while mk == 255 && i + 2 < n {
                i = i + 1
                mk = bytes_at(b, i + 1) & 255
            }
            if mk == 216 {
                i = i + 2
            } else {
                if mk == 217 {
                    return img_info_fail("jpeg: no SOF")
                }
                if mk >= 192 && mk <= 195 {
                    if i + 9 >= n {
                        return img_info_fail("jpeg: truncated SOF")
                    }
                    let h = img_be16(b, i + 5)
                    let w = img_be16(b, i + 7)
                    return img_info_ok(img_fmt_jpeg(), w, h)
                }
                if mk == 1 || (mk >= 208 && mk <= 215) {
                    i = i + 2
                } else {
                    if i + 3 >= n {
                        return img_info_fail("jpeg: truncated marker")
                    }
                    let len = img_be16(b, i + 2)
                    if len < 2 {
                        return img_info_fail("jpeg: bad marker len")
                    }
                    i = i + 2 + len
                }
            }
        }
    }
    return img_info_fail("jpeg: no SOF")
}
